<Window x:Class="MozijegyFoglalo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MozijegyFoglalo"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">
    
    <Grid Margin="30">
        
        <StackPanel>

            <TextBlock Text="Mozijegy foglaló"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="Black"/>

            <TextBlock Text="Név"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,25,0,5"/>
            <TextBox x:Name="txtNev"
                     FontSize="14"
                     Padding="6" 
                     Width="170"
                     HorizontalAlignment="Left"/>

            <TextBlock Text="Életkor"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,5,0,5"/>
            <TextBox x:Name="txtEletkor"
                     FontSize="14"
                     Padding="6" 
                     Width="170"
                     HorizontalAlignment="Left"/>

            <TextBlock Text="Film"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,5,0,5"/>
            <ComboBox x:Name="comboFilmKivalasztas"
                      FontSize="14"
                      Padding="6" 
                      Width="170"
                      HorizontalAlignment="Left">
                         <ComboBoxItem Content="Backrooms: Hátsó szobák" />
                         <ComboBoxItem Content="Öt éjjel Freddy pizzázójában" />
                         <ComboBoxItem Content="Harry Potter (👎)" />
            </ComboBox>

            <TextBlock Text="Jegytípus"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,5,0,5"/>
            <RadioButton x:Name="radioNormal"
                         IsChecked="True"
                         Content="Normál jegy - 2500 Ft"
                         GroupName="jegyTipus"
                         FontSize="14"/>
            <RadioButton x:Name="radioDiak"
                         Content="Diákjegy - 1900 Ft"
                         GroupName="jegyTipus"
                         FontSize="14"/>
            <RadioButton x:Name="radioVip"
                         Content="VIP jegy - 4500 Ft"
                         GroupName="jegyTipus"
                         FontSize="14"/>

            <TextBlock Text="Jegyek száma"
                         FontSize="14"
                         FontWeight="Bold"
                         Margin="0,5,0,5"/>
            <TextBox x:Name="txtJegyszam"
                         FontSize="14"
                         Padding="6" 
                         Width="170"
                         HorizontalAlignment="Left"/>

            <TextBlock Text="Jegyek száma"
                         FontSize="14"
                         FontWeight="Bold"
                         Margin="0,5,0,5"/>
            <CheckBox x:Name="checkPopcorn"
                      Content="Popcorn - 1200 Ft"
                      FontSize="14"
                      HorizontalAlignment="Left"/>
            <CheckBox x:Name="checkUdito"
                      Content="Üdítő - 800 Ft"
                      FontSize="14"
                      HorizontalAlignment="Left"/>
            <CheckBox x:Name="checkSzemuveg"
                      Content="3D szemüveg - 500 Ft"
                      FontSize="14"
                      HorizontalAlignment="Left"/>

            <CheckBox x:Name="checkFeltetelek"
                      Content="Elfogadom a vásárlási feltételeket"
                      FontWeight="Bold"
                      FontSize="14"
                      Margin="0,20,0,0"
                      HorizontalAlignment="Left"/>

            <TextBlock x:Name="hibaJelzo"
                    FontSize="14"
                    FontWeight="Bold"
                    Margin="0,5,0,5"
                    Foreground="red"/>

            <Button x:Name="buttonValidalo"
                    FontSize="14"
                    Content="Foglalás"
                    Width="250"
                    Height="50"
                    FontWeight="Bold"
                    Margin="0,5,0,5"
                    Click="FoglalasValidacio"/>

        </StackPanel>
    </Grid>
</Window>
